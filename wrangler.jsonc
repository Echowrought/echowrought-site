// Cloudflare Workers config: a static site with a tiny Worker in front.
// Everything in ./public is served as-is at echowrought.com.
// src/worker.js shows public/maintenance.html instead when the Cloudflare
// variable `maintenance` is set to "true" (Settings > Variables and Secrets).
{
  "name": "echowrought-site",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Keep the `maintenance` value set in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  // At most 30 not-found lookups a minute per visitor (see src/quiet.js).
  "ratelimits": [
    { "name": "ECHO_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ]
}
